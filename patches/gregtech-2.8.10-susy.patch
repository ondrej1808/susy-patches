+        if (query.startsWith("@")) {
+            ResourceLocation id = stack.getItem().getRegistryName();
+            return id != null && id.getNamespace().toLowerCase(Locale.ROOT).contains(query.substring(1));
+        }
+        return stack.getDisplayName().toLowerCase(Locale.ROOT).contains(query);
+    }
