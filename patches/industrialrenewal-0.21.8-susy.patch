+    @Override
+    public List<ItemStack> extractAllContents()
+    {
+        List<ItemStack> out = new ArrayList<>();
+        ItemStack all = inventory.extractAll();
+        if (all.isEmpty()) return out;
+        int left = all.getCount();
+        int max = Math.max(1, all.getMaxStackSize());
